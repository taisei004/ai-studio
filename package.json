{
  "name": "ai-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:worker": "wrangler dev --port 4317",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --port 4317",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply ai-studio-db --local",
    "db:remote": "wrangler d1 migrations apply ai-studio-db --remote",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "wrangler": "^4.43.0",
    "miniflare": "^4.20260730.0"
  }
}
